# =====================================================================
# Plantilla de variables de entorno del Centro Cultural Inteligente
# Copia este archivo como .env y reemplaza los valores.
# NUNCA subas el archivo .env real al repositorio.
# =====================================================================

# --- Base de datos PostgreSQL ---
DB_NAME=centro_cultural
DB_USER=centro_user
DB_PASSWORD=CHANGE_ME_WITH_A_SECURE_PASSWORD
DB_HOST=database
DB_PORT=5432

# --- Persistencia (bind mount en el host / AWS EBS) ---
# En AWS EC2 se recomienda: /opt/centro-cultural/postgres-data
# En local (Windows/Mac/Linux) puedes usar una ruta relativa: ./postgres-data
POSTGRES_DATA_PATH=/opt/centro-cultural/postgres-data

# --- Entorno de la aplicación ---
APP_ENV=production
